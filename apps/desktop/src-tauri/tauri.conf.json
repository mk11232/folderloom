{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folderloom Demo",
  "version": "2026.11.1",
  "identifier": "com.folderloom.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run licenses",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folderloom",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Read-only folder inventory and comparison",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/licenses/": "licenses/"
    }
  }
}
